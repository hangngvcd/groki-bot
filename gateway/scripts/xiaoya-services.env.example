# 複製去 ~/.stackchan/xiaoya-services.env，然後 chmod 600。
# Copy outside the repo; values are literal, without quotes or shell expansion.
# 換成「小芽」agent 嘅資料，兩個 ID 必須完全一樣。
# Replace with your child agent details; both IDs must match exactly.
STACKCHAN_GBOT_VOICE_BOT_ID=YOUR_AGENT_ID
STACKCHAN_TOOL_BOT=YOUR_AGENT_NAME
STACKCHAN_TOOL_BOT_ID=YOUR_AGENT_ID
# 裝置 token，至少 16 字；唔好貼入聊天。Device token, never paste into chat.
STACKCHAN_TOKEN=generate-a-long-random-token
# 選填／Optional: 1 = 「鈴鈴」wake word + 撳掣 (default), 0 = 只准撳掣 / button only.
# 撳掣模式一定開住：冇 wake word model 都唔會將聲音全部轉發。
# Button-only listening is always forced on, so audio is never passed through.
# STACKCHAN_WAKE_WORD=1
# 選填／Optional: STACKCHAN_KWS_THRESHOLD, STACKCHAN_KWS_SCORE,
# STACKCHAN_GBOT_VOICE_LANGUAGE, STACKCHAN_GBOT_VOICE_NAME, STACKCHAN_WAKE_IDLE_S,
# STACKCHAN_KWS_MODEL_DIR (default gateway/models/kws),
# UV_BIN, NODE_BIN (absolute executable paths / 完整執行檔路徑).
# 對話調校（選填）／Dialogue tuning (optional):
# STACKCHAN_LOG_USER_TRANSCRIPTS=1 寫逐字稿去 ~/Library/Logs/xiaoya/transcripts-YYYY-MM-DD.log
#   (default off; dir override STACKCHAN_TRANSCRIPT_LOG_DIR).
# STACKCHAN_GBOT_TRANSCRIBE_LANGUAGE (default = voice language; "auto" omits the hint),
# STACKCHAN_GBOT_KEYTERMS=0 disables keyterms, STACKCHAN_GBOT_EXTRA_KEYTERMS=a,b,c,
# STACKCHAN_GBOT_VAD_SILENCE_MS (1300), STACKCHAN_GBOT_VAD_PREFIX_MS (300),
# STACKCHAN_GBOT_BARGE_MIN_MS (600), STACKCHAN_GBOT_BARGE_DBFS (-40),
# STACKCHAN_GBOT_MAX_SENTENCES (2; 0 = no cap), STACKCHAN_GLYPH_MIRROR (1).

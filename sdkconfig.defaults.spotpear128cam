# SpotPear ESP32-S3 1.28-CAM skeleton (hardware bring-up: ticket 14).
# Sources: SpotPear schematic A1 / factory image / Xiaozhi sibling box;
# see docs/hardware.md for links and confidence labels.
CONFIG_STACKCHAN_BOARD_SPOTPEAR_128CAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"
# Native USB-C uses GPIO19/20; USB-Serial-JTAG avoids UART0/camera options.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_STACKCHAN_CAMERA_ENABLED=n
CONFIG_STACKCHAN_QR_TEST_AT_BOOT=n
CONFIG_STACKCHAN_SERVO_ENABLED=n
CONFIG_STACKCHAN_HEAD_TOUCH_ENABLED=n
CONFIG_STACKCHAN_PY32_ENABLED=n
CONFIG_STACKCHAN_LED_ENABLED=n
CONFIG_STACKCHAN_COMPANION_FACE=y
# Cantonese companion uses gateway/cloud conversation; no Japanese synthesis.
CONFIG_STACKCHAN_JTTS_ENABLED=n
CONFIG_JTTS_ENABLE_HMM=n
CONFIG_STACKCHAN_TELEGRAM_ENABLED=n
CONFIG_TELEGRAM_PHASE1_ENABLED=n
CONFIG_STACKCHAN_ESPNOW_POC=n
CONFIG_STACKCHAN_ESPNOW_REMOTE_ENABLED=n
